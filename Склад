function applyMove(){
  const type = document.getElementById("moveType").value;
  const qty = Number(document.getElementById("moveQty").value);
  const note = document.getElementById("moveNote").value.trim();
  if(isNaN(qty) || qty <= 0){ showToast("Количество > 0", true); return; }
  const it = DATA[moveIndex];
  if(type === "out" && qty > it.q){ showToast("Недостаточно остатка", true); return; }
  it.q += type === "in" ? qty : -qty;
  logAction(`${type==="in"?"➕ Приход":"➖ Расход"}: «${it.n}» ${type==="in"?"+":"-"}${qty} ${it.u}${note?" ("+note+")":""}`);
  saveWarehouses(); closeModal("moveModal"); renderAll();
  showToast(`${type==="in"?"Приход":"Расход"} применён`);
}

