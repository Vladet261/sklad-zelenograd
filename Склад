function importFile(e){
  const file = e.target.files[0]; if(!file) return;
  const reader = new FileReader();
  const isCSV = /\.csv$/i.test(file.name);
  reader.onload = ev=>{
    const text = ev.target.result;
    if(isCSV){
      importCSV(text);
    }else{
      importJSON(text);
    }
    e.target.value = "";
  };
  reader.readAsText(file, "UTF-8");
}

function importJSON(text){
  try{
    const parsed = JSON.parse(text);
    if(parsed.warehouses){
      if(!confirm("Загрузить резервную копию?\nТекущие данные будут заменены.")) return;
      WAREHOUSES = parsed.warehouses;
      CURRENT = parsed.current || Object.keys(WAREHOUSES)[0];
      setCurrentWarehouseName(CURRENT);
      DATA = WAREHOUSES[CURRENT];
      saveWarehouses();
      renderAll();
      showToast(`📂 Загружено: ${Object.keys(WAREHOUSES).length} склад(ов)`);
      return;
    }
    const arr = Array.isArray(parsed) ? parsed : parsed.data;
    if(!Array.isArray(arr)) throw new Error("Неверный формат JSON");
    if(!confirm(`Загрузить ${arr.length} позиций в склад «${CURRENT}»?\nТекущие данные будут заменены.`)) return;
    DATA = arr.map(x=>({...x, min:x.min??3}));
    WAREHOUSES[CURRENT] = DATA;
    saveWarehouses(); renderAll();
    showToast(`📂 Загружено ${arr.length} позиций`);
  }catch(err){ showToast("⚠️ " + err.message, true); }
}

function importCSV(text){
  const lines = text.split(/\r?\n/).filter(l=>l.trim());
  if(lines.length < 2){ showToast("CSV пустой", true); return; }
  const sep = lines[0].includes(";") ? ";" : ",";
  const parseLine = line => {
    const out = []; let cur = ""; let inQ = false;
    for(let i=0;i<line.length;i++){
      const ch = line[i];
      if(ch === '"'){
        if(inQ && line[i+1] === '"'){ cur += '"'; i++; }
        else inQ = !inQ;
      }else if(ch === sep && !inQ){ out.push(cur); cur = ""; }
      else cur += ch;
    }
    out.push(cur);
    return out;
  };
  const header = parseLine(lines[0]).map(h=>h.toLowerCase());
  const idxName = header.findIndex(h=>/наимен|name/.test(h));
  const idxArt  = header.findIndex(h=>/артик|art/.test(h));
  const idxQty  = header.findIndex(h=>/кол|qty|количест/.test(h));
  const idxUnit = header.findIndex(h=>/ед|unit/.test(h));
  if(idxName < 0 || idxQty < 0){ showToast("CSV: не найдены колонки «Наименование» и «Количество»", true); return; }

  const items = [];
  for(let i=1;i<lines.length;i++){
    const cols = parseLine(lines[i]);
    const name = (cols[idxName]||"").trim();
    const qty = Number((cols[idxQty]||"0").replace(",", "."));
    if(!name) continue;
    items.push({
      n: name,
      a: idxArt>=0 ? (cols[idxArt]||"").trim() : "",
      q: isNaN(qty) ? 0 : qty,
      u: idxUnit>=0 ? (cols[idxUnit]||"шт.").trim() : "шт.",
      min: 3
    });
  }
  if(!items.length){ showToast("Не удалось прочитать позиции", true); return; }
  if(!confirm(`Импортировать ${items.length} позиций из CSV?\nТекущие данные будут заменены.`)) return;
  DATA = items;
  WAREHOUSES[CURRENT] = DATA;
  saveWarehouses(); renderAll();
  showToast(`📂 Импортировано ${items.length} позиций`);
}

