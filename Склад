<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Склад «Зеленоград» — v4.0</title>
<style>
  :root{
    --bg:#0f172a; --panel:#1e293b; --panel2:#273449; --text:#e2e8f0;
    --muted:#94a3b8; --accent:#38bdf8; --ok:#22c55e; --warn:#f59e0b; --bad:#ef4444;
  }
  *{box-sizing:border-box}
  body{margin:0;font-family:'Segoe UI',system-ui,sans-serif;
       background:var(--bg);color:var(--text);padding:16px;max-width:1300px;margin:auto}
  h1{font-size:1.4rem;margin:0 0 4px}
  .sub{color:var(--muted);font-size:.85rem;margin-bottom:14px}
  .topbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:14px;
          background:var(--panel);padding:12px 16px;border-radius:12px}
  .topbar label{font-size:.8rem;color:var(--muted)}
  .topbar select,.topbar input{padding:8px 10px;border-radius:8px;border:1px solid var(--panel2);
       background:var(--bg);color:var(--text);font-size:.85rem;font-family:inherit}
  .user-chip{margin-left:auto;font-size:.85rem;display:flex;gap:8px;align-items:center}
  .user-chip b{color:var(--accent)}

  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:16px}
  .stat{background:var(--panel);border-radius:12px;padding:14px 16px;
        border-left:4px solid var(--accent);cursor:pointer;transition:.15s;position:relative}
  .stat:hover{transform:translateY(-2px);background:var(--panel2)}
  .stat.active{outline:2px solid var(--accent);outline-offset:2px}
  .stat .num{font-size:1.6rem;font-weight:700;line-height:1.1}
  .stat .lbl{color:var(--muted);font-size:.72rem;text-transform:uppercase;letter-spacing:.5px;margin-top:2px}
  .stat .hint{color:var(--muted);font-size:.7rem;margin-top:5px;line-height:1.3}
  .stat .arrow{position:absolute;top:8px;right:10px;font-size:.85rem;opacity:.6}
  .stat.warn{border-color:var(--warn)} .stat.bad{border-color:var(--bad)} .stat.ok{border-color:var(--ok)}

  .controls{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;align-items:center}
  input[type=search]{flex:1;min-width:200px;padding:10px 14px;border-radius:10px;
       border:1px solid var(--panel2);background:var(--panel);color:var(--text);font-size:.9rem}
  input[type=search]:focus{outline:2px solid var(--accent)}
  button{padding:9px 13px;border-radius:10px;border:1px solid var(--panel2);
         background:var(--panel);color:var(--text);cursor:pointer;font-size:.82rem;
         transition:.15s;font-family:inherit}
  button:hover{background:var(--panel2)}
  .primary{background:var(--accent);color:#0b1220;font-weight:600;border:none}
  .primary:hover{filter:brightness(1.1);background:var(--accent)}
  .success{background:var(--ok);color:#06210f;font-weight:600;border:none}
  .danger{background:var(--bad);color:#fff;font-weight:600;border:none}
  .warnbtn{background:var(--warn);color:#1a1200;font-weight:600;border:none}

  .banner{display:none;align-items:center;justify-content:space-between;
    background:var(--panel2);border-left:4px solid var(--accent);
    padding:10px 14px;border-radius:10px;margin-bottom:12px;gap:10px;flex-wrap:wrap;font-size:.88rem}
  .banner.show{display:flex}
  .banner b{color:var(--accent)}

  .anchors{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}
  .anchors button{font-size:.78rem;padding:6px 11px;border-radius:20px;background:var(--panel2)}
  .anchors button.active{background:var(--accent);color:#0b1220;font-weight:600}

  .group{margin-bottom:20px;scroll-margin-top:12px}
  .group h2{font-size:.95rem;color:var(--accent);margin:0 0 6px;padding-bottom:5px;
            border-bottom:1px solid var(--panel2);display:flex;justify-content:space-between}
  .group h2 span{color:var(--muted);font-weight:400;font-size:.78rem}
  table{width:100%;border-collapse:collapse;background:var(--panel);border-radius:12px;overflow:hidden}
  th{background:var(--panel2);text-align:left;padding:9px 10px;font-size:.72rem;
     text-transform:uppercase;letter-spacing:.4px;color:var(--muted);cursor:pointer;user-select:none}
  th:hover{color:var(--accent)}
  th.no-sort{cursor:default}
  td{padding:8px 10px;border-top:1px solid #2e3d55;font-size:.85rem;vertical-align:middle}
  tr:hover td{background:#243149}
  .num-cell{color:var(--muted);width:36px;font-size:.75rem}
  .qty{white-space:nowrap;font-weight:700;text-align:right;width:110px}
  .art{color:var(--muted);font-size:.78rem;white-space:nowrap}
  .low .qty{color:var(--warn)} .crit .qty{color:var(--bad)}
  .expired td{opacity:.6}
  .expired .qty{color:var(--bad);text-decoration:line-through}
  .row-actions{white-space:nowrap;width:170px;text-align:right}
  .row-actions button{padding:4px 7px;font-size:.78rem;border-radius:7px;margin-left:3px}
  .thumb{width:32px;height:32px;object-fit:cover;border-radius:6px;vertical-align:middle;margin-right:6px}
  .empty{padding:30px;text-align:center;color:var(--muted);background:var(--panel);border-radius:12px}
  .stock-tag{display:inline-block;font-size:.65rem;padding:1px 6px;border-radius:5px;margin-left:5px}
  .stock-tag.ok{background:#14532d;color:#86efac}
  .stock-tag.low{background:#4a2e00;color:#fcd34d}
  .stock-tag.crit{background:#4a1010;color:#fca5a5}
  @media(max-width:700px){.art,.thumb{display:none}.row-actions{width:auto}}

  .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);
    display:none;align-items:center;justify-content:center;z-index:100;padding:16px;overflow-y:auto}
  .modal-overlay.show{display:flex}
  .modal{background:var(--panel);border-radius:16px;padding:22px;width:100%;
         max-width:520px;box-shadow:0 20px 60px rgba(0,0,0,.6);max-height:92vh;overflow-y:auto}
  .modal.wide{max-width:900px}
  .modal h3{margin:0 0 14px;font-size:1.05rem}
  .modal label{display:block;font-size:.78rem;color:var(--muted);margin:10px 0 4px}
  .modal input,.modal select,.modal textarea{width:100%;padding:9px 11px;border-radius:9px;
    border:1px solid var(--panel2);background:var(--bg);color:var(--text);font-size:.9rem;font-family:inherit}
  .modal input:focus,.modal select:focus,.modal textarea:focus{outline:2px solid var(--accent)}
  .modal .row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .modal-actions{display:flex;gap:10px;margin-top:18px;justify-content:flex-end;flex-wrap:wrap}
  .hist-item{padding:8px 0;border-bottom:1px solid var(--panel2);font-size:.82rem;display:flex;gap:10px}
  .hist-item .t{color:var(--muted);white-space:nowrap;font-size:.75rem}
  .hist-item .a{flex:1}
  .toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);
    background:var(--ok);color:#06210f;padding:11px 20px;border-radius:10px;
    font-weight:600;font-size:.88rem;opacity:0;transition:.3s;pointer-events:none;z-index:300}
  .toast.show{opacity:1;bottom:30px}
  .toast.err{background:var(--bad);color:#fff}

  /* Печать */
  @media print{
    body{background:#fff;color:#000;padding:0}
    .topbar,.controls,.anchors,.stats,.row-actions,button,.banner{display:none!important}
    .group h2{color:#000;border-color:#000}
    table{background:#fff}
    th{background:#eee;color:#000}
    td{border-color:#ccc}
    .no-print{display:none!important}
  }
  .print-area{display:none}
  .print-area.show{display:block;background:#fff;color:#000;padding:20px}
  .print-area h2{color:#000}
  .print-area table{background:#fff}
  .print-area th{background:#eee;color:#000}
  .print-area td{border:1px solid #ccc;color:#000}
  .print-area .blank{display:inline-block;width:60px;border-bottom:1px solid #000}

  /* Отчёты */
  .report-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin-bottom:16px}
  .report-card{background:var(--panel2);padding:14px;border-radius:10px}
  .report-card h4{margin:0 0 8px;font-size:.85rem;color:var(--accent)}
  .bar{height:8px;background:#334155;border-radius:4px;overflow:hidden;margin-top:4px}
  .bar>div{height:100%;background:var(--accent)}
  .report-row{display:flex;justify-content:space-between;font-size:.8rem;padding:3px 0}

  /* QR */
  .qr-box{text-align:center;padding:10px}
  .qr-box img{width:200px;height:200px;background:#fff;padding:10px;border-radius:10px}
  .qr-box p{font-size:.85rem;margin:8px 0 0}

  /* Печать этикеток */
  .labels{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px}
  .label-card{border:1px solid #334155;border-radius:8px;padding:10px;background:var(--panel2);text-align:center;font-size:.75rem}
  .label-card img{width:100px;height:100px;background:#fff;padding:4px;border-radius:6px}
  .label-card b{display:block;margin-top:4px;font-size:.78rem;line-height:1.2}
  .label-card small{color:var(--muted)}
</style>
</head>
<body>

<h1>📦 Склад «Зеленоград» <small style="font-size:.7rem;color:var(--muted)">v4.0</small></h1>
<div class="sub">Нажмите на плитку статистики — откроется отфильтрованный список. Все данные сохраняются в браузере.</div>

<!-- Верхняя панель: склад + пользователь -->
<div class="topbar">
  <label>Склад:</label>
  <select id="warehouseSel" onchange="switchWarehouse(this.value)"></select>
  <div class="user-chip" id="userChip"></div>
</div>

<!-- Статистика -->
<div class="stats" id="stats"></div>

<!-- Баннер фильтра -->
<div class="banner" id="banner">
  <div id="bannerText"></div>
  <button onclick="clearFilter()">✖ Сбросить фильтр</button>
</div>

<!-- Управление -->
<div class="controls">
  <input type="search" id="search" placeholder="🔍 Поиск по названию или артикулу...">
  <button class="primary" onclick="openAdd()">➕ Добавить</button>
  <button class="warnbtn" onclick="openReorderList()">🔔 Пора заказать</button>
  <button class="success" onclick="printPurchaseList()">🖨️ На закупку</button>
  <button onclick="printLabels()">🏷️ Этикетки</button>
  <button onclick="openReports()">📈 Отчёты</button>
  <button onclick="openHistory()">📜 История</button>
  <button class="success" onclick="exportCSV()">📥 CSV</button>
  <button onclick="exportJSON()">💾 Копия</button>
  <button onclick="document.getElementById('importFile').click()">📂 Загрузить</button>
  <button class="danger" onclick="resetData()">♻️ Сброс</button>
  <input type="file" id="importFile" accept=".json,.csv,.txt" style="display:none" onchange="importFile(event)">
</div>

<!-- Якоря категорий -->
<div class="anchors" id="anchors"></div>

<!-- Таблица -->
<div id="tableWrap"></div>

<!-- ПЕЧАТЬ: область -->
<div class="print-area" id="printArea"></div>

<!-- ===== МОДАЛЬНЫЕ ОКНА ===== -->

<!-- Добавить/редактировать -->
<div class="modal-overlay" id="modal">
  <div class="modal">
    <h3 id="modalTitle">Добавить позицию</h3>
    <label>Наименование *</label>
    <input type="text" id="f-name" placeholder="Например: Шлифовальные круги 125мм">
    <div class="row2">
      <div><label>Артикул / марка</label><input type="text" id="f-art" placeholder="P1000"></div>
      <div><label>Единица</label>
        <select id="f-unit">
          <option>шт.</option><option>кг.</option><option>гр.</option><option>л.</option>
          <option>м.</option><option>упак.</option><option>коробок</option>
          <option>кругов</option><option>рулон</option>
        </select>
      </div>
    </div>
    <div class="row2">
      <div><label>Количество *</label><input type="number" id="f-qty" min="0" step="1" value="0"></div>
      <div><label>Мин. запас (порог «мало»)</label><input type="number" id="f-min" min="0" step="1" value="3"></div>
    </div>
    <label>Срок годности (если есть)</label>
    <input type="date" id="f-exp">
    <label>Фото (необязательно)</label>
    <input type="file" id="f-photo" accept="image/*" onchange="handlePhoto(event)">
    <div id="photoPreview"></div>
    <div class="modal-actions">
      <button onclick="closeModal('modal')">Отмена</button>
      <button class="primary" onclick="saveItem()">Сохранить</button>
    </div>
  </div>
</div>

<!-- Приход/расход -->
<div class="modal-overlay" id="moveModal">
  <div class="modal">
    <h3 id="moveTitle">Движение товара</h3>
    <p style="font-size:.85rem;color:var(--muted)" id="moveItemName"></p>
    <div class="row2">
      <div><label>Тип</label>
        <select id="moveType"><option value="in">➕ Приход</option><option value="out">➖ Расход</option></select>
      </div>
      <div><label>Количество *</label><input type="number" id="moveQty" min="1" step="1" value="1"></div>
    </div>
    <label>Кому / откуда / примечание</label>
    <input type="text" id="moveNote" placeholder="Например: Иванов, объект №2">
    <div class="modal-actions">
      <button onclick="closeModal('moveModal')">Отмена</button>
      <button class="primary" onclick="applyMove()">Применить</button>
    </div>
  </div>
</div>

<!-- История -->
<div class="modal-overlay" id="histModal">
  <div class="modal wide">
    <h3>📜 История операций</h3>
    <div id="histList" style="max-height:60vh;overflow-y:auto"></div>
    <div class="modal-actions">
      <button onclick="clearHistory()">Очистить историю</button>
      <button class="primary" onclick="closeModal('histModal')">Закрыть</button>
    </div>
  </div>
</div>

<!-- Отчёты -->
<div class="modal-overlay" id="reportModal">
  <div class="modal wide">
    <h3>📈 Отчёты и аналитика</h3>
    <div id="reportBody"></div>
    <div class="modal-actions">
      <button class="primary" onclick="closeModal('reportModal')">Закрыть</button>
    </div>
  </div>
</div>

<!-- Пора заказать -->
<div class="modal-overlay" id="reorderModal">
  <div class="modal wide">
    <h3>🔔 Пора заказать (остаток ниже мин. запаса)</h3>
    <div id="reorderBody"></div>
    <div class="modal-actions">
      <button class="success" onclick="printReorderList()">🖨️ Печать</button>
      <button class="primary" onclick="closeModal('reorderModal')">Закрыть</button>
    </div>
  </div>
</div>

<!-- Вход -->
<div class="modal-overlay" id="loginModal">
  <div class="modal">
    <h3>👤 Вход</h3>
    <label>Ваше имя</label>
    <input type="text" id="loginName" placeholder="Например: Иванов И.И.">
    <label>Роль</label>
    <select id="loginRole">
      <option value="admin">Администратор (полный доступ)</option>
      <option value="storekeeper">Кладовщик (может менять)</option>
      <option value="viewer">Снабженец (только смотреть)</option>
    </select>
    <div class="modal-actions">
      <button onclick="closeModal('loginModal')">Отмена</button>
      <button class="primary" onclick="doLogin()">Войти</button>
    </div>
  </div>
</div>

<!-- QR -->
<div class="modal-overlay" id="qrModal">
  <div class="modal" style="max-width:340px">
    <h3>🏷️ QR-код позиции</h3>
    <div class="qr-box" id="qrBox"></div>
    <div class="modal-actions">
      <button onclick="closeModal('qrModal')">Закрыть</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

