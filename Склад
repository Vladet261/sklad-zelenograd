function renderStats(){
  const totalPos = DATA.length;
  const totalUnits = DATA.reduce((s,x)=>s+(+x.q||0),0);
  const catCount = new Set(DATA.map(x=>getCat(x.n).id)).size;
  const crit = DATA.filter(x=>x.q===0).length;
  const low = DATA.filter(x=>x.q>0 && x.q<=(x.min||3)).length;
  const okCount = DATA.filter(x=>x.q>(x.min||3)).length;
  const reorder = DATA.filter(x=>x.q < (x.min||3)).length;

  const tiles = [
    {key:"all",  cls:"",    num:totalPos, lbl:"Всего позиций", hint:"Показать всё", arrow:"→"},
    {key:"units",cls:"",    num:totalUnits.toLocaleString('ru'), lbl:"Единиц товара", hint:"Сумма количеств"},
    {key:"cats", cls:"",    num:catCount, lbl:"Категорий", hint:"Групп материалов"},
    {key:"ok",   cls:"ok",  num:okCount, lbl:"Достаточно", hint:"Выше мин. запаса", arrow:"→"},
    {key:"low",  cls:"warn",num:low, lbl:"Мало", hint:"На границе порога", arrow:"→"},
    {key:"crit", cls:"bad", num:crit, lbl:"Нет в наличии", hint:"Остаток 0", arrow:"→"},
    {key:"reorder", cls:"bad", num:reorder, lbl:"Пора заказать", hint:"Ниже мин. запаса", arrow:"→"}
  ];

  document.getElementById("stats").innerHTML = tiles.map(t=>`
    <div class="stat ${t.cls} ${state.stockFilter===t.key?'active':''}"
         ${["all","ok","low","crit","reorder"].includes(t.key) ? `onclick="setStockFilter('${t.key}')"` : ''}>
      <div class="arrow">${t.arrow||""}</div>
      <div class="num">${t.num}</div>
      <div class="lbl">${t.lbl}</div>
      <div class="hint">${t.hint}</div>
    </div>
  `).join("");
}
function setStockFilter(key){
  state.stockFilter = state.stockFilter === key ? "all" : key;
  if(state.stockFilter !== "all") state.cat = "all";
  if(state.stockFilter === "reorder"){ openReorderList(); state.stockFilter="all"; renderStats(); return; }
  renderStats(); renderBanner(); renderAnchors(); renderTable();
  if(state.stockFilter !== "all") window.scrollTo({top:0, behavior:"smooth"});
}
function clearFilter(){
  state.stockFilter = "all"; state.cat = "all"; state.query = "";
  document.getElementById("search").value = "";
  renderStats(); renderBanner(); renderAnchors(); renderTable();
}
function renderBanner(){
  const b = document.getElementById("banner");
  const txt = document.getElementById("bannerText");
  if(state.stockFilter === "all"){ b.classList.remove("show"); return; }
  const map = {
    ok:   "Показаны позиции с запасом выше мин.",
    low:  "⚠️ Позиции на границе порога",
    crit: "🔴 Позиции с нулевым остатком"
  };
  txt.innerHTML = map[state.stockFilter] || "";
  b.classList.add("show");
}
function matchesStockFilter(it){
  if(state.stockFilter === "all") return true;
  const min = it.min||3;
  if(state.stockFilter === "ok")   return it.q > min;
  if(state.stockFilter === "low")  return it.q > 0 && it.q <= min;
  if(state.stockFilter === "crit") return it.q === 0;
  return true;
}

