function saveItem(){
  const n = document.getElementById("f-name").value.trim();
  const a = document.getElementById("f-art").value.trim();
  const q = Number(document.getElementById("f-qty").value);
  const m = Number(document.getElementById("f-min").value);
  const u = document.getElementById("f-unit").value;
  const exp = document.getElementById("f-exp").value;
  if(!n){ showToast("Введите наименование", true); return; }
  if(isNaN(q) || q < 0){ showToast("Количество ≥ 0", true); return; }

  let photo;
  if(tempPhoto === "__remove__") photo = "";
  else if(tempPhoto) photo = tempPhoto;
  else if(editingIndex >= 0) photo = DATA[editingIndex].photo || "";
  else photo = "";

  const item = {n, a, q, u, min:isNaN(m)?3:m, exp, photo};
  if(editingIndex === -1){
    DATA.push(item);
    logAction(`➕ Добавлено: «${n}» ${q} ${u}`);
    showToast("✅ Добавлено");
  }else{
    DATA[editingIndex] = item;
    logAction(`✏️ Изменено: «${n}»`);
