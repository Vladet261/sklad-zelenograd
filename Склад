    <div style="background:var(--panel2);padding:14px;border-radius:10px">
      ${Object.values(cats).map(c=>`
        <div style="margin-bottom:10px">
          <div class="report-row"><span>${c.name}</span><b>${c.count} поз. · ${c.units.toLocaleString('ru')} ед.${c.low?' · ⚠️ '+c.low+' мало':''}</b></div>
