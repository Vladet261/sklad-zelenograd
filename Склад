function exportCSV(){
  const rows = [["№","Наименование","Артикул","Кол-во","Ед.","Мин.","Срок","Категория","Статус"]];
  DATA.forEach((it,i)=>{
    const c = getCat(it.n);
    const status = it.q===0 ? "Нет" : it.q<=(it.min||3) ? "Мало" : "OK";
    rows.push([i+1, it.n, it.a||"", it.q, it.u, it.min||3, it.exp||"",
      c.name.replace(/[^\wа-яёА-ЯЁ\s]/gi,"").trim(), status]);
  });
  const csv = "\uFEFF" + rows.map(r=>r.map(v=>`"${String(v).replace(/"/g,'""')}"`).join(";")).join("\r\n");
  downloadFile(csv, `Склад_${CURRENT}_${new Date().toISOString().slice(0,10)}.csv`, "text/csv;charset=utf-8;");
  showToast("📥 CSV экспортирован");
}

