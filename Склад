function renderAnchors(){
  const groups = {};
  DATA.forEach(it=>{
    if(!matchesStockFilter(it)) return;
    const c = getCat(it.n); (groups[c.id] ||= {name:c.name, count:0}).count++;
  });
  const order = CATEGORIES.map(c=>c.id).concat("other");
  let html = `<button class="${state.cat==='all'?'active':''}" data-cat="all">Все (${Object.values(groups).reduce((s,g)=>s+g.count,0)})</button>`;
  order.forEach(id=>{
    if(!groups[id]) return;
    html += `<button class="${state.cat===id?'active':''}" data-cat="${id}">${groups[id].name} <b>${groups[id].count}</b></button>`;
  });
  document.getElementById("anchors").innerHTML = html;
  document.querySelectorAll("#anchors button").forEach(b=>{
    b.onclick = ()=>{
      state.cat = b.dataset.cat;
      renderAnchors(); renderTable();
      if(state.cat!=="all"){
        const el = document.getElementById("g-"+state.cat);
        if(el) el.scrollIntoView({behavior:"smooth", block:"start"});
      }
    };
  });
}

/* ============================================================
   ТАБЛИЦА
   ============================================================ */
function renderTable(){
  const q = state.query.toLowerCase().trim();
  const order = CATEGORIES.map(c=>c.id).concat("other");
  let html = ""; let shown = 0;

  order.forEach(id=>{
    if(state.cat!=="all" && state.cat!==id) return;
    let items = DATA.map((it,i)=>({...it, idx:i}))
      .filter(it=>{
        if(getCat(it.n).id !== id) return false;
        if(!matchesStockFilter(it)) return false;
        if(!q) return true;
        return (it.n+" "+(it.a||"")).toLowerCase().includes(q);
      });
    if(state.sortKey){
      items.sort((a,b)=>{
        const va = a[state.sortKey] ?? "", vb = b[state.sortKey] ?? "";
        if(typeof va === "number" && typeof vb === "number") return (va-vb)*state.sortDir;
        return String(va).localeCompare(String(vb))*state.sortDir;
      });
    }
    if(!items.length) return;
    shown += items.length;
    const catName = getCat(items[0].n).name;
    html += `<div class="group" id="g-${id}">
      <h2>${catName} <span>${items.length} поз.</span></h2>
      <table><thead><tr>
        <th class="no-sort">№</th>
        <th onclick="sortBy('n')">Наименование ${sortIcon('n')}</th>
        <th onclick="sortBy('a')">Артикул ${sortIcon('a')}</th>
        <th style="text-align:right" onclick="sortBy('q')">Кол-во ${sortIcon('q')}</th>
        <th class="no-sort"></th>
      </tr></thead><tbody>`;
    items.forEach(it=>{
      const min = it.min||3;
      const isCrit = it.q === 0;
      const isLow = it.q > 0 && it.q <= min;
      const cls = isCrit ? "crit" : isLow ? "low" : "";
      const expired = it.exp && new Date(it.exp) < new Date();
      let tag = "";
      if(isCrit) tag = `<span class="stock-tag crit">нет</span>`;
      else if(isLow) tag = `<span class="stock-tag low">мало</span>`;
      const thumb = it.photo ? `<img class="thumb" src="${it.photo}">` : "";
      const expStr = it.exp ? `<div style="font-size:.7rem;color:${expired?'var(--bad)':'var(--muted)'}">до ${it.exp}</div>` : "";
      const editBtn = canEdit() ? `
        <button class="success" onclick="openMove(${it.idx})" title="Приход/расход">＋−</button>
        <button onclick="openQR(${it.idx})" title="QR-код">🏷️</button>
        <button onclick="openEdit(${it.idx})" title="Редактировать">✏️</button>
        <button onclick="deleteItem(${it.idx})" title="Удалить">🗑️</button>` : "";
      html += `<tr class="${cls} ${expired?'expired':''}">
        <td class="num-cell">${it.idx+1}</td>
        <td>${thumb}${esc(it.n)}${tag}${expStr}</td>
        <td class="art">${esc(it.a)||"—"}</td>
        <td class="qty">${it.q} ${esc(it.u)}<div style="font-size:.65rem;color:var(--muted);font-weight:400">мин ${min}</div></td>
        <td class="row-actions">${editBtn}</td>
      </tr>`;
    });
    html += `</tbody></table></div>`;
  });

  let emptyMsg;
  if(shown === 0){
    if(state.stockFilter === "crit" && !q) emptyMsg = "🎉 Позиций с нулевым остатком нет.";
    else if(state.stockFilter === "low" && !q) emptyMsg = "✅ Позиций на границе порога нет.";
    else if(q) emptyMsg = `Ничего не найдено по запросу «${esc(state.query)}»`;
    else emptyMsg = "Список пуст. Нажмите «➕ Добавить».";
  }
  document.getElementById("tableWrap").innerHTML = shown
    ? html : `<div class="empty">${emptyMsg}</div>`;
}
function sortBy(key){
  if(state.sortKey === key) state.sortDir *= -1;
  else { state.sortKey = key; state.sortDir = 1; }
  renderTable();
}
function sortIcon(k){
  if(state.sortKey !== k) return "";
  return state.sortDir === 1 ? "▲" : "▼";
}

